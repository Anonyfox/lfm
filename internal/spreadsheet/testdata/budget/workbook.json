     },
     "type": "enum",
     "values": [
      "@needs",
      "@wants",
      "@savings"
     ],
     "width": 14
    },
    {
     "key": "budget",
     "title": {
      "en": "Monthly budget",
      "de": "Monatsbudget"
     },
     "type": "money"
    },
    {
     "key": "spent",
     "title": {
      "en": "Spent",
      "de": "Ausgegeben"
     },
     "type": "money",
     "formula": "=IF([.name]=\"\",\"\",-SUMIFS([log.amount],[log.category],[.name],[log.date],\">=\"&[month_start],[log.date],\"<=\"&[month_end]))"
    },
    {
     "key": "left",
     "title": {
      "en": "Left",
      "de": "Übrig"
     },
     "type": "money",
     "formula": "=IF([.name]=\"\",\"\",[.budget]-[.spent])",
     "highlight": [
      {
       "if": "<0",
       "style": "bad"
      }
     ]
    },
    {
     "key": "used",
     "title": {
      "en": "Used",
      "de": "Verbraucht"
     },
     "type": "percent",
     "formula": "=IF(OR([.name]=\"\",[.budget]=0),\"\",[.spent]/[.budget])",
     "highlight": [
      {
       "if": ">1",
       "style": "bad"
      },
      {
       "if": ">=0.9",
       "style": "warn"
      }
     ]
    }
