  {
   "key": "dashboard",
   "name": {
    "en": "Dashboard",
    "de": "Übersicht"
   },
   "kind": "report",
   "widths": [
    2,
    30,
    16,
    4,
    30,
    16
   ],
   "cells": [
    {
     "at": "B2",
     "text": {
      "en": "This month",
      "de": "Dieser Monat"
     },
     "style": "title"
    },
    {
     "at": "C2",
     "formula": "=[month_start]",
     "type": "date",
     "style": "title"
    },
    {
     "at": "B4",
     "text": {
      "en": "Income",
      "de": "Einnahmen"
     },
     "style": "label"
    },
    {
     "at": "C4",
     "name": "income",
     "type": "money",
     "formula": "=SUMIFS([log.amount],[log.amount],\">0\",[log.date],\">=\"&[month_start],[log.date],\"<=\"&[month_end])"
    },
    {
     "at": "B5",
     "text": {
      "en": "Spent",
      "de": "Ausgegeben"
     },
     "style": "label"
    },
    {
     "at": "C5",
     "name": "spent",
     "type": "money",
     "formula": "=-SUMIFS([log.amount],[log.amount],\"<0\",[log.date],\">=\"&[month_start],[log.date],\"<=\"&[month_end])"
    },
    {
     "at": "B6",
     "text": {
      "en": "Left this month",
      "de": "Übrig diesen Monat"
     },
     "style": "label"
    },
    {
     "at": "C6",
     "name": "left",
     "type": "money",
     "style": "total",
     "formula": "=[income]-[spent]",
     "highlight": [
      {
       "if": "<0",
       "style": "bad"
      }
     ]
    },
    {
     "at": "B7",
     "text": {
      "en": "Savings goal",
      "de": "Sparziel"
     },
     "style": "label"
    },
    {
     "at": "C7",
     "name": "goal",
     "type": "money",
     "formula": "=ROUND([income]*[savings_rate],2)"
    },
    {
     "at": "B8",
     "text": {
      "en": "Safe to spend until payday",
      "de": "Bis zum Zahltag frei verfügbar"
     },
     "style": "label"
    },
    {
     "at": "C8",
     "name": "safe",
     "type": "money",
     "style": "total",
     "formula": "=MAX(0,[left]-[goal])"
    },
    {
     "at": "B9",
     "text": {
      "en": "Days until payday",
      "de": "Tage bis zum Zahltag"
     },
     "style": "label"
    },
    {
     "at": "C9",
     "name": "days",
     "type": "number",
     "formula": "=MAX(0,[payday]-TODAY())"
    },
    {
     "at": "B10",
     "text": {
      "en": "Safe to spend per day",
      "de": "Pro Tag frei verfügbar"
     },
     "style": "label"
    },
    {
     "at": "C10",
     "name": "per_day",
     "type": "money",
     "style": "total",
     "formula": "=IF([days]=0,[safe],ROUND([safe]/[days],2))"
    },
    {
     "at": "E4",
     "text": {
      "en": "Needs (aim: 50%)",
      "de": "Fixkosten (Ziel: 50 %)"
     },
     "style": "label"
    },
    {
     "at": "F4",
     "name": "needs",
     "type": "percent",
     "formula": "=IF([income]=0,0,SUMIFS([categories.spent],[categories.group],[@needs])/[income])",
     "highlight": [
      {
       "if": ">0.5",
       "style": "warn"
      }
     ]
    },
    {
     "at": "E5",
     "text": {
      "en": "Wants (aim: 30%)",
      "de": "Wünsche (Ziel: 30 %)"
     },
     "style": "label"
    },
    {
     "at": "F5",
     "name": "wants",
     "type": "percent",
     "formula": "=IF([income]=0,0,SUMIFS([categories.spent],[categories.group],[@wants])/[income])",
     "highlight": [
      {
       "if": ">0.3",
       "style": "warn"
      }
     ]
    },
    {
     "at": "E6",
     "text": {
      "en": "Savings (aim: 20%)",
      "de": "Sparen (Ziel: 20 %)"
     },
     "style": "label"
    },
    {
     "at": "F6",
     "name": "saved",
     "type": "percent",
     "formula": "=IF([income]=0,0,SUMIFS([categories.spent],[categories.group],[@savings])/[income])",
     "highlight": [
      {
       "if": ">=0.2",
       "style": "good"
      }
     ]
    },
    {
     "at": "E8",
     "text": {
      "en": "Monthly budget",
      "de": "Monatsbudget"
     },
     "style": "label"
    },
    {
     "at": "F8",
     "name": "budget",
     "type": "money",
     "formula": "=SUM([categories.budget])"
    },
    {
     "at": "E9",
     "text": {
      "en": "Categories over budget",
      "de": "Kategorien über Budget"
     },
     "style": "label"
    },
    {
     "at": "F9",
     "name": "over",
     "type": "number",
     "formula": "=COUNTIF([categories.left],\"<0\")",
     "highlight": [
      {
       "if": ">0",
       "style": "bad"
      }
     ]
    }
   ],
   "charts": [
    {
     "type": "doughnut",
     "title": {
      "en": "Spending by category",
      "de": "Ausgaben nach Kategorie"
     },
     "labels": "[categories.name]",
     "values": "[categories.spent]",
     "at": "B12",
     "width": 420,
     "height": 300
    },
    {
     "type": "bar",
     "title": {
      "en": "Spent per category",
      "de": "Ausgegeben je Kategorie"
     },
     "labels": "[categories.name]",
     "values": "[categories.spent]",
     "at": "E12",
     "width": 420,
     "height": 300
    }
   ]
